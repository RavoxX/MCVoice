# MCVoice backend configuration (shared by backend/go and backend/rust).
# Copy to .env and adjust. Never commit a real .env file.

# --- network ---------------------------------------------------------------
CONTROL_BIND_ADDRESS=0.0.0.0
CONTROL_PORT=8080
VOICE_BIND_ADDRESS=0.0.0.0
VOICE_UDP_PORT=24455
# Hostname clients use for UDP voice (defaults to the Host header of the control request).
PUBLIC_HOSTNAME=voice.example.org
# UDP port announced to clients if it differs from VOICE_UDP_PORT (NAT/port mapping).
PUBLIC_VOICE_PORT=
# Serve TLS directly (otherwise terminate TLS in a reverse proxy; clients require wss:// in production).
TLS_CERT_PATH=
TLS_KEY_PATH=
# Honour X-Forwarded-For for per-IP rate limits (only behind a trusted reverse proxy).
TRUST_PROXY_HEADERS=false

# --- authentication --------------------------------------------------------
# mojang  = verify Minecraft accounts via sessionserver hasJoined (production)
# offline = trust the claimed UUID (DEVELOPMENT ONLY)
AUTH_MODE=mojang
MOJANG_SESSION_URL=https://sessionserver.mojang.com/session/minecraft/hasJoined
# >= 32 random characters, e.g. `openssl rand -base64 48`. Signs resume tokens. Share across replicas.
JWT_SIGNING_SECRET=
# >= 32 random characters. Keys the hash used to pseudonymise IP addresses in logs.
SESSION_SECRET=
RESUME_TOKEN_TTL_SECONDS=3600
KEY_ROTATION_SECONDS=600
# Optional companion-plugin attestations: name:base64key(>=32 bytes),...
SCOPE_ATTESTATION_KEYS=

# --- proximity / routing ---------------------------------------------------
NORMAL_RANGE=48
WHISPER_RANGE=8
MAX_RANGE=96
ROUTING_DISTANCE_SLACK=4
ROUTING_REQUIRE_MUTUAL_VISIBILITY=true

# --- limits ----------------------------------------------------------------
MAX_SESSIONS=10000
SESSION_TIMEOUT_SECONDS=20
RATE_LIMIT_VOICE_PER_SEC=75
RATE_LIMIT_VOICE_BURST=150
RATE_LIMIT_CONTROL_PER_SEC=40
RATE_LIMIT_CONTROL_BURST=80
RATE_LIMIT_CONNECT_PER_MIN=30
RATE_LIMIT_AUTH_FAIL_PER_MIN=10
# Go backend: UDP reader goroutines (0 = GOMAXPROCS). Rust backend: UDP worker tasks (0 = CPU count).
UDP_WORKERS=0

# --- moderation / persistence ----------------------------------------------
# JSON file {"banned":["uuid"],"muted":["uuid"]}, re-read every 30 s.
BANS_FILE=
# Reserved for future versions (accounts, distributed presence). Ignored with a warning in 0.1.x.
DATABASE_URL=
REDIS_URL=

# --- logging ---------------------------------------------------------------
LOG_LEVEL=info
LOG_FORMAT=json
# Positions are never logged unless this is true AND LOG_LEVEL=debug.
LOG_POSITIONS=false
